{
	"name": "trpc-svelte-query",
	"version": "4.0.0",
	"description": "Use tRPC with SvelteKit and Tanstack Query (full SSR support)",
	"author": "Ottomated",
	"license": "MIT",
	"type": "module",
	"module": "dist/index.svelte.js",
	"typesVersions": {
		"*": {
			"*": [
				"dist/index.svelte.d.ts"
			],
			"server": [
				"dist/server/index.d.ts"
			]
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ottomated/trpc-svelte-query.git"
	},
	"scripts": {
		"prepublish": "pnpm build",
		"build": "rm -rf dist && tsup",
		"lint": "eslint --fix --ext \".js,.ts\" --report-unused-disable-directives src",
		"dev": "tsup --watch"
	},
	"exports": {
		".": "./dist/index.svelte.js",
		"./server": "./dist/server/index.js"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"peerDependencies": {
		"@sveltejs/kit": ">=2.20.0 <3",
		"@tanstack/svelte-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"svelte": ">=5.44.0 <6"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.49.0",
		"@tanstack/svelte-query": "^6.0.9",
		"@trpc/client": "^11.7.2",
		"@trpc/server": "^11.7.2",
		"@types/node": "^24.10.1",
		"oxfmt": "^0.15.0",
		"oxlint": "^1.30.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.22.0"
}
